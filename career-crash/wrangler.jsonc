// careercrash.org: the offline game (career mode + Sandbox) as a static site on
// Cloudflare Workers. Built by `pnpm build:web`, deployed by Workers Builds from
// the `prod` branch (see PIPELINES.md §6.4). The API worker is separate
// (apps/worker/wrangler.toml).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "career-crash",
  "compatibility_date": "2025-09-01",
  // Only redirects www → careercrash.org (apps/client/src/site-worker.ts); everything else is assets.
  "main": "./apps/client/src/site-worker.ts",
  "assets": {
    "directory": "./apps/client/dist-web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The script runs for pages and public files only; the hashed bundle under /assets/ is served
    // straight from the asset store (no Worker invocation), so this costs about one call per page view.
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "routes": [
    { "pattern": "careercrash.org", "custom_domain": true },
    { "pattern": "www.careercrash.org", "custom_domain": true }
  ]
}
