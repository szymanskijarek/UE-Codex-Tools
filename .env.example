# Target Unreal project root for BlueprintMCP.
UE_PROJECT_DIR=D:/Path/To/Your/UnrealProject

# Unreal editor command path.
UE_EDITOR_CMD=D:/Path/To/UnrealEditor-Cmd.exe

# HTTP endpoint exposed by the UE LLM Toolkit / CCBridge plugin in the editor.
UNREAL_MCP_URL=http://localhost:3000
MCP_REQUEST_TIMEOUT_MS=30000

# Optional BlueprintMCP port override.
UE_PORT=9847

# Local Perforce settings. Replace these with your own workspace values if needed.
P4PORT=192.168.1.250:1666
P4USER=your-perforce-user
P4CLIENT=your-perforce-workspace
